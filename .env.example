# Copy to .env and fill in for your environment.
# Either set DATABASE_URL directly, or the discrete PG* vars below (used as a fallback).

DATABASE_URL=postgresql+psycopg2://asx_user:change_me@localhost:5432/asx_value

PGHOST=localhost
PGPORT=5432
PGDATABASE=asx_value
PGUSER=asx_user
PGPASSWORD=change_me

# Web GUI (python gui.py). Required for --lan (phone access on home Wi-Fi);
# if set, the browser asks for it on every device, including this PC.
# GUI_PASSWORD=choose-something-long
